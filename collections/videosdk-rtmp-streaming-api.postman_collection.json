          "name": "Start RTMP Live Stream",
          "request": {
            "name": "Start RTMP Live Stream",
            "description": {
              "content": "Start an RTMP live stream from a meeting session to one or more external platforms.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "livestreams",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"<string>\",\n  \"outputs\": [\n    {\n      \"streamKey\": \"<string>\",\n      \"url\": \"<uri>\"\n    },\n    {\n      \"streamKey\": \"<string>\",\n      \"url\": \"<uri>\"\n    }\n  ],\n  \"templateUrl\": \"<uri>\",\n  \"transcription\": {\n    \"enabled\": \"<boolean>\",\n    \"summary\": {\n      \"enabled\": \"<boolean>\",\n      \"prompt\": \"<string>\"\n    }\n  },\n  \"config\": {\n    \"layout\": {\n      \"type\": \"<string>\",\n      \"priority\": \"<string>\",\n      \"gridSize\": \"<integer>\"\n    },\n    \"theme\": \"<string>\",\n    \"recording\": {\n      \"enabled\": \"<boolean>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
